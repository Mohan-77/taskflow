# MongoDB connection string. Used by lib/db.ts and lib/mongoose.ts.
MONGODB_URI=

# Secret used by Better Auth to sign sessions. At least 32 characters.
BETTER_AUTH_SECRET=

# Public origin of this app, including protocol and port. Example: http://localhost:3000
BETTER_AUTH_URL=

# API key for Resend. Server-side email only.
RESEND_API_KEY=

# Sender address that Resend allows.
EMAIL_FROM=

# Recipient for scripts/send-test-email.ts only. Not used by the task API.
EMAIL_TEST_TO=
