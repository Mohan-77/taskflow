# Local MongoDB connection string. Used in development when MONGODB_URI_DEV is empty.
MONGODB_URI=

# Optional development connection string. Overrides MONGODB_URI outside production.
MONGODB_URI_DEV=

# Production connection string. Required when NODE_ENV is production. No fallback.
MONGODB_URI_PRO=

# Secret used by Better Auth to sign sessions. At least 32 characters.
BETTER_AUTH_SECRET=

# Public origin of this app, including protocol and port. Example: http://localhost:3000
BETTER_AUTH_URL=

# API key for Resend. Server-side email only.
RESEND_API_KEY=

# Sender address that Resend allows.
EMAIL_FROM=

# Recipient for scripts/send-test-email.ts only. Not used by the task API.
EMAIL_TEST_TO=
